{
  "$description": "Signal design tokens. Source of truth for colour, type, space, radius, elevation, motion and sizing. Generate CSS with `node design/scripts/build-tokens.mjs`; verify WCAG 2.1 AA with `node design/scripts/check-contrast.mjs`.",
  "version": "0.1.0",
  "status": "v0.1",
  "defaultTheme": "dark",
  "color": {
    "themes": {
      "dark": {
        "bg": "#0E1116",
        "surface": "#161A21",
        "surface-raised": "#1D222B",
        "surface-sunken": "#0A0C10",
        "border": "#2A303B",
        "border-strong": "#737D8D",
        "text": "#E8EBF0",
        "text-muted": "#AAB2BF",
        "text-inverse": "#0E1116",
        "link": "#8DB7FF",
        "primary": "#8DB7FF",
        "primary-hover": "#AECBFF",
        "on-primary": "#0A1322",
        "focus": "#FFC857",
        "success": "#63D69F",
        "success-surface": "#0F2A1E",
        "warning": "#F5C451",
        "warning-surface": "#2E2410",
        "danger": "#FF9189",
        "danger-surface": "#33161A",
        "danger-solid": "#FF9189",
        "on-danger": "#2A0B0E",
        "info": "#8DB7FF",
        "info-surface": "#122036",
        "neutral-surface": "#252A34",
        "synthetic": "#F5C451",
        "synthetic-surface": "#2E2410",
        "chart-1": "#8DB7FF",
        "chart-2": "#63D69F",
        "chart-target": "#F5C451",
        "chart-grid": "#2A303B",
        "overlay": "rgba(5, 7, 10, 0.72)"
      },
      "light": {
        "bg": "#F6F7F9",
        "surface": "#FFFFFF",
        "surface-raised": "#FFFFFF",
        "surface-sunken": "#ECEFF3",
        "border": "#D5DAE1",
        "border-strong": "#6E7888",
        "text": "#12161C",
        "text-muted": "#4A5361",
        "text-inverse": "#FFFFFF",
        "link": "#1D53C4",
        "primary": "#1D53C4",
        "primary-hover": "#17439F",
        "on-primary": "#FFFFFF",
        "focus": "#A84300",
        "success": "#146C3B",
        "success-surface": "#E5F4EB",
        "warning": "#7F4D00",
        "warning-surface": "#FFF3D6",
        "danger": "#B42318",
        "danger-surface": "#FDECEA",
        "danger-solid": "#B42318",
        "on-danger": "#FFFFFF",
        "info": "#1D53C4",
        "info-surface": "#E8F0FD",
        "neutral-surface": "#ECEFF3",
        "synthetic": "#7F4D00",
        "synthetic-surface": "#FFF3D6",
        "chart-1": "#1D53C4",
        "chart-2": "#146C3B",
        "chart-target": "#A84300",
        "chart-grid": "#D5DAE1",
        "overlay": "rgba(18, 22, 28, 0.48)"
      }
    }
  },
  "contrast": {
    "$description": "Every foreground/background pair the UI uses. text pairs need 4.5:1 (WCAG 1.4.3); nonText pairs (UI component boundaries, focus, chart marks) need 3:1 (WCAG 1.4.11). Checked for every theme.",
    "text": [
      ["text", "bg"],
      ["text", "surface"],
      ["text", "surface-raised"],
      ["text", "surface-sunken"],
      ["text", "neutral-surface"],
      ["text-muted", "bg"],
      ["text-muted", "surface"],
      ["text-muted", "surface-raised"],
      ["text-muted", "neutral-surface"],
      ["link", "bg"],
      ["link", "surface"],
      ["link", "surface-raised"],
      ["on-primary", "primary"],
      ["on-primary", "primary-hover"],
      ["on-danger", "danger-solid"],
      ["success", "success-surface"],
      ["success", "surface"],
      ["warning", "warning-surface"],
      ["warning", "surface"],
      ["danger", "danger-surface"],
      ["danger", "surface"],
      ["info", "info-surface"],
      ["synthetic", "synthetic-surface"],
      ["text-inverse", "text"]
    ],
    "nonText": [
      ["border-strong", "bg"],
      ["border-strong", "surface"],
      ["border-strong", "surface-raised"],
      ["focus", "bg"],
      ["focus", "surface"],
      ["focus", "surface-raised"],
      ["primary", "bg"],
      ["primary", "surface"],
      ["chart-1", "surface"],
      ["chart-2", "surface"],
      ["chart-target", "surface"]
    ]
  },
  "typography": {
    "fontFamily": {
      "sans": "ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
      "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace"
    },
    "scale": {
      "xs": { "size": "0.75rem", "lineHeight": "1rem" },
      "sm": { "size": "0.875rem", "lineHeight": "1.25rem" },
      "md": { "size": "1rem", "lineHeight": "1.5rem" },
      "lg": { "size": "1.125rem", "lineHeight": "1.625rem" },
      "xl": { "size": "1.375rem", "lineHeight": "1.875rem" },
      "2xl": { "size": "1.75rem", "lineHeight": "2.25rem" },
      "3xl": { "size": "2.25rem", "lineHeight": "2.75rem" }
    },
    "weight": { "regular": "400", "medium": "500", "semibold": "600", "bold": "700" }
  },
  "space": {
    "0": "0",
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "5": "1.25rem",
    "6": "1.5rem",
    "8": "2rem",
    "10": "2.5rem",
    "12": "3rem",
    "16": "4rem"
  },
  "radius": { "sm": "4px", "md": "8px", "lg": "12px", "xl": "16px", "pill": "999px" },
  "elevation": {
    "dark": {
      "1": "0 1px 2px rgba(0, 0, 0, 0.45)",
      "2": "0 4px 12px rgba(0, 0, 0, 0.5)",
      "3": "0 12px 32px rgba(0, 0, 0, 0.6)"
    },
    "light": {
      "1": "0 1px 2px rgba(18, 22, 28, 0.08)",
      "2": "0 4px 12px rgba(18, 22, 28, 0.12)",
      "3": "0 12px 32px rgba(18, 22, 28, 0.18)"
    }
  },
  "motion": {
    "duration": { "instant": "0ms", "fast": "120ms", "base": "200ms", "slow": "320ms" },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "enter": "cubic-bezier(0, 0, 0, 1)",
      "exit": "cubic-bezier(0.4, 0, 1, 1)"
    },
    "reducedMotion": {
      "$description": "Applied under prefers-reduced-motion: reduce. Movement is removed; state changes stay instant and visible.",
      "duration": { "instant": "0ms", "fast": "0ms", "base": "0ms", "slow": "0ms" }
    }
  },
  "size": {
    "touch-target": "44px",
    "control-height": "44px",
    "focus-ring-width": "3px",
    "focus-ring-offset": "2px",
    "sidebar-width": "240px",
    "content-max": "1240px",
    "drawer-width": "min(560px, 100vw)"
  },
  "zIndex": { "header": "10", "drawer": "40", "modal": "50", "toast": "60" }
}
