{
  "name": "signal-studio",
  "version": "0.1.0",
  "private": false,
  "description": "Signal: a self-hosted Instagram content studio with AI agents. Brand import, campaigns, post generators, approval board, calendar, scheduler, results, memory and a trust-based autopilot.",
  "license": "MIT",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev -p 3000 -H 127.0.0.1",
    "dev:https": "next dev -p 3000 -H 127.0.0.1 --experimental-https --experimental-https-key \"${SIGNAL_DEV_CERT_KEY:-$HOME/.signal/certs/signal-dev-key.pem}\" --experimental-https-cert \"${SIGNAL_DEV_CERT:-$HOME/.signal/certs/signal-dev.pem}\"",
    "build": "next build --webpack",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "app:prepare": "SIGNAL_STANDALONE=1 next build --webpack && node desktop/prepare.mjs",
    "app:dev": "npm --prefix desktop run dev",
    "app:build": "npm run app:prepare && npm --prefix desktop install && npm --prefix desktop run dist",
    "tokens": "node design/scripts/build-tokens.mjs",
    "tokens:check": "node design/scripts/check-contrast.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.318",
    "@fontsource/fraunces": "5.2.9",
    "@fontsource/instrument-sans": "5.2.8",
    "ffmpeg-static": "5.3.0",
    "next": "16.3.8",
    "opentype.js": "1.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.5",
    "@types/opentype.js": "1.3.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "jsdom": "30.1.1",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
