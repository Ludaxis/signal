# Signal Studio — example environment. Contains no values.
# Copy to .env.local (git-ignored). Every variable is optional unless marked REQUIRED.
# Feature switches (what may spend money, publish, schedule or run unattended) live in
# signal.config.json — see signal.config.example.json. Nothing in this file turns those on.

# ---- Sign-in (single owner) -------------------------------------------------------------------
# REQUIRED unless SIGNAL_LOCAL_ONLY_NO_PASSWORD=1. At least 8 characters.
SIGNAL_OWNER_PASSWORD=
# 1 = no password, accepted only from localhost / 127.0.0.1 / [::1] on plain http. Never expose such a server.
SIGNAL_LOCAL_ONLY_NO_PASSWORD=
# Signs the session cookie (any long random string, e.g. `openssl rand -base64 32`).
# Unset: a random secret is made at start and every session ends when the server restarts.
SIGNAL_SESSION_SECRET=
# Public origin of the app for the same-origin check on mutating requests (set it behind a reverse proxy).
SIGNAL_WEB_ORIGIN=

# ---- Locations ---------------------------------------------------------------------------------
# Feature switches file (default ./signal.config.json).
SIGNAL_CONFIG_FILE=
# Projects, account settings and default content folders (default ./data).
SIGNAL_DATA_DIR=
# Encrypted Instagram tokens (default ~/.signal). Keep it outside any repository.
SIGNAL_SECRETS_DIR=
# Optional prompt overrides for the agents: <dir>/_shared.md and <dir>/<role>/prompt.md (default ./agents).
SIGNAL_PROMPTS_DIR=
# Overrides for the two data files (rarely needed).
SIGNAL_PROJECTS_FILE=
SIGNAL_ACCOUNTS_FILE=
# Single-project mode without the wizard: a posts folder plus the account identity.
SIGNAL_CONTENT_DIR=
SIGNAL_PROJECT_ID=
SIGNAL_PROJECT_NAME=
SIGNAL_PROJECT_HANDLE=
UPLOAD_POST_PROFILE=

# ---- Time zone ---------------------------------------------------------------------------------
# IANA zone for calendar days, posting times and the autopilot window (default UTC). Read at build time too.
NEXT_PUBLIC_SIGNAL_TIME_ZONE=

# ---- Kill switches -----------------------------------------------------------------------------
# 1 = nothing is posted or scheduled anywhere; reads still work.
SIGNAL_PUBLISH_PAUSED=
# 1 = no automatic runs and no automatic approvals.
SIGNAL_AUTOPILOT_PAUSED=

# ---- Instagram API with Unified Login (Meta) — switch "unifiedLogin" + "instagramApi" -----------
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=
# Must be https and end with /api/studio/instagram/callback
META_REDIRECT_URI=
# 32 random bytes in base64 (`openssl rand -base64 32`); encrypts stored tokens.
SIGNAL_TOKEN_KEY=
# Graph API version (default v26.0).
META_GRAPH_VERSION=

# ---- Instagram API with Instagram Login (legacy, one long-lived token per project) ---------------
# INSTAGRAM_TOKEN_<PROJECT ID IN CAPS, dashes become underscores>, e.g. INSTAGRAM_TOKEN_MY_BRAND
INSTAGRAM_TOKEN_MY_BRAND=
INSTAGRAM_API_VERSION=

# ---- Cloudflare R2 (public media links while posting through Instagram's API) -------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# https://<public bucket host or custom domain>
R2_PUBLIC_BASE=

# ---- Upload-Post --------------------------------------------------------------------------------
UPLOAD_POST_API_KEY=

# ---- Agents --------------------------------------------------------------------------------------
# Your Anthropic API key: pays for agent runs when switch "agentsApiKey" is on; required by the agent team and the judge.
SIGNAL_ANTHROPIC_API_KEY=
# Model for CLI agent runs (default: Claude Code's default; sonnet when paid by the key).
CLAUDE_AGENT_MODEL=
# Pin exact model ids per tier for the agent team (defaults: the tier aliases).
SIGNAL_TEAM_MODEL_OPUS=
SIGNAL_TEAM_MODEL_SONNET=
SIGNAL_TEAM_MODEL_HAIKU=
# Model for the routing judge (Messages API).
SIGNAL_JUDGE_MODEL=
# Paths to the CLIs when they are not on PATH.
CLAUDE_BIN=
CODEX_BIN=

# ---- Higgsfield (switch "higgsfield"; paid per request) ------------------------------------------
HF_API_KEY_ID=
HF_API_KEY_SECRET=

# ---- Development ---------------------------------------------------------------------------------
# Hostname you serve the dev server on over HTTPS (Meta's callback needs https); added to allowedDevOrigins.
SIGNAL_DEV_HOST=
# Certificate files for `npm run dev:https` (defaults: ~/.signal/certs/signal-dev-key.pem and signal-dev.pem).
SIGNAL_DEV_CERT_KEY=
SIGNAL_DEV_CERT=
# Extra origin allowed for images/media in the CSP (e.g. a CDN); empty by default.
SIGNAL_MEDIA_ORIGIN=
# 1 = allow the brand importer to fetch private-network addresses (local test sites only).
SIGNAL_ALLOW_PRIVATE_FETCH=
